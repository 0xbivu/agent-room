def cli(kind, model, effort, conversation="", resume=False):
    """Launch command. Auto modes: safe actions run on their own, risky ones ask you (shown in the chat).
    --add-dir gives every agent access to your whole home folder, not just the workspace."""
    e = lambda flag: f" {flag}{shlex.quote(effort)}" if effort else ""
    if conversation:
        conversation = str(uuid.UUID(conversation))
    return {
        "claude": f"claude --model {shlex.quote(model)}{e('--effort ')} --dangerously-skip-permissions --add-dir {shlex.quote(HOME)}"
                  + (f" --{'resume' if resume else 'session-id'} {conversation}" if conversation else ""),
        "codex": f"codex{' resume' if resume else ''} --no-daemon -m {shlex.quote(model)}{e('-c model_reasoning_effort=')} --dangerously-bypass-approvals-and-sandbox --add-dir {shlex.quote(HOME)}"
                 + (f" {conversation}" if resume else ""),
        "agy": f"agy --model {shlex.quote(model)}{e('--effort ')} --dangerously-skip-permissions --add-dir {shlex.quote(HOME)}"
               + (f" --conversation {conversation}" if resume else "") + " -i",  # auto-approve, like claude/codex
    }[kind]
# don't leak a parent Claude Code session's env into the agents we start
