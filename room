def kill(name, forget=True):
    a = agents().get(name)
    if not a:
        return print(f"no agent named {name}")
    tmux("kill-pane", "-t", a[0])
    if forget:
        save_agent(remove=name)
    print(f"killed {name}" + (" (core agent: the router will restart it)" if name in CORE else ""))


def switch_room(sid=None, fresh=False):
    live = agents()
    record_conversations(live)
    if sid:
        if sid not in {s['id'] for s in api('/sessions')['sessions']}:
            sys.exit('no such room session')
        roster = room_agents(sid)
    elif fresh:
        roster = room_agents()
    else:
        roster = {}
    if not roster:
        roster = {}
        for name in CORE:
            model, effort = agent_settings(name, name)
            roster[name] = {'name': name, 'kind': name, 'model': model, 'effort': effort, 'conversation_id': ''}
    for r in roster.values():
        if not re.fullmatch(r'[a-z][a-z0-9_-]{0,15}', r['name']) or r['name'] in ('user', 'all', 'room') or r['kind'] not in DEFAULTS:
            sys.exit('invalid agent in saved session')
        if not all(re.fullmatch(r'[\w.:-]+', v) for v in (r['model'], r['effort'] or 'x')):
            sys.exit('invalid model or effort in saved session')
        if r.get('conversation_id'):
            try:
                uuid.UUID(r['conversation_id'])
            except ValueError:
                sys.exit('invalid CLI conversation id in saved session')
    try:
        if fresh:
            api('/clear', {'from': 'room', 'text': '--- chat cleared; fresh CLI conversations in the same room session ---'})
        else:
            api('/sessions/resume' if sid else '/sessions/new', {'id': sid} if sid else {})
    except urllib.error.HTTPError as e:
        sys.exit('could not switch room session: ' + e.read().decode())
    for name in live:
        kill(name, forget=False)
    for r in roster.values():
        if fresh:
            r = {**r, 'conversation_id': '', 'launch_id': ''}
            save_agent(r)
        spawn(r['name'], r['kind'], window='room:team' if r['name'] in CORE else None, record=r)
    print('fresh CLI conversations in the current room session' if fresh else f"room session {api('/session')['id']}")


def up():
    docker = lambda *a: subprocess.run(["docker", *a], capture_output=True, text=True)
    # rebuild (cached, fast) and replace the server when it isn't running or runs an older server.py/index.html
    image = subprocess.run(["docker", "build", "-q", "-t", "agent-room", DIR], check=True, capture_output=True, text=True).stdout.strip()
    running = docker("inspect", "-f", "{{.State.Running}} {{.Image}}", "agent-room").stdout.split()
    if running != ["true", image]:
        print("starting chat server (docker)...")
        docker("rm", "-f", "agent-room")
        r = docker("run", "-d", "--name", "agent-room", "-p", "127.0.0.1:9090:8765",
                   "-v", f"{DIR}/data:/data", "agent-room")
        if r.returncode:
            sys.exit(r.stderr)
    for _ in range(60):
        try:
            api("/messages?since=999999999")
            break
        except Exception:
            time.sleep(0.5)
    else:
        sys.exit("room server did not come up (docker logs agent-room)")
    if subprocess.run(["tmux", "has-session", "-t", "room"], capture_output=True).returncode:
        api('/sessions/new', {})
        tmux("new-session", "-d", "-s", "room", "-n", "team", "-c", WS, "-x", "240", "-y", "60",
             "-e", "ROOM_MAIN=1", "room chat")
        tmux("new-window", "-d", "-t", "room:", "-n", "router", "room router")
        print("started tmux session 'room' (core agents are coming up)")
    else:
        print("already running")
    print("chat: this terminal, or http://localhost:9090 in a browser")


def down():
    subprocess.run(["docker", "rm", "-f", "agent-room"], capture_output=True)
    print("stopped chat server and all agents")
    tmux("kill-session", "-t", "room")  # last: this may kill our own pane


CHAT_CMDS = ("who", "models", "model", "spawn", "kill", "clear", "fresh", "approve", "deny", "send", "key", "peek", "sessions", "resume", "new")
KEYS = ("Escape", "Enter", "Up", "Down", "Left", "Right", "Tab", "BTab", "C-c", "y", "n", *"123456789")


def last_lines(pane, n=10):
    return "\n".join([l for l in tmux("capture-pane", "-p", "-t", pane).splitlines() if l.strip()][-n:])


OPTION = re.compile(r"^\s*[❯›>]?\s*(\d+)\.\s+(.+?)\s*$", re.M)


def option_keys(screen, choice):
    options = [int(n) for n, _ in OPTION.findall(screen)]
    if not options:
        return ["Enter"] if choice == 1 else None
    if choice not in options:
        return None
    selected = re.search(r"^\s*[❯›>]\s*(\d+)\.\s", screen, re.M)
    # shortcut: an unmarked menu is assumed to select its first option; revisit if a CLI hides its cursor.
    current = int(selected[1]) if selected else options[0]
    if current not in options:
        return None
    steps = options.index(choice) - options.index(current)
    return ["Down" if steps > 0 else "Up"] * abs(steps) + ["Enter"]


# startup dialogs the router answers itself so no agent ever sits on them: (title, labels, pick).
# Claude and agy hide option numbers, so options are matched by label and reached with arrow keys.
# Picks are the safe "continue" choice (never enable new MCP servers / hooks / API keys).
STARTUP = [
    ("Is this a project you created or one you trust", ["No, exit", "No, continue without these permissions", "Yes, I trust this folder"], "Yes, I trust this folder"),
    ("Do you trust the contents of this project", ["Yes, I trust this folder", "No, exit"], "Yes, I trust this folder"),
    ("Bypass Permissions mode", ["No, exit", "Yes, I accept"], "Yes, I accept"),
    ("Trust this folder?", ["Trust and continue", "Open restricted", "Quit"], "Trust and continue|Open restricted"),
    ("Update available!", ["Update now", "Skip until next version", "Skip"], "Skip until next version"),
    ("Hooks need review", ["Trust all and continue", "Continue without trusting"], "Continue without trusting"),
    ("Working directory", ["Use session directory", "Use current directory", "Always use current directory"], "Use current directory"),
    ("MCP server", ["Use this MCP server", "Use this and all future MCP servers in this project", "Continue without using this MCP server"], "Continue without using this MCP server"),
    ("Allow external CLAUDE.md file imports?", ["Yes, allow external imports", "No, disable external imports"], "No, disable external imports"),
    ("Do you want to use this API key?", ["Yes", "No (recommended)"], "No (recommended)"),
    ("Claude in Chrome extension detected", ["Yes, use my browser", "No, keep browser tools off"], "No, keep browser tools off"),
]


def menu_keys(screen, labels, pick):
    """Arrow keys + Enter that move the menu cursor (❯/›/>) onto the first label in pick ("a|b")."""
    rows = []
    for line in screen.splitlines():
        text = re.sub(r"^\s*[❯›>]?\s*(?:\d+\.\s*)?", "", line).strip()
        label = max((l for l in labels if text.startswith(l)), key=len, default=None)
        if label:
            rows.append((label, bool(re.match(r"\s*[❯›>]", line))))
    names = [label for label, _ in rows]
    target = next((names.index(t) for t in pick.split("|") if t in names), None)
    if target is None or len(rows) < 2 or not any(on for _, on in rows):  # need a live menu cursor, not just prose
        return None
    current = next((i for i, (_, on) in enumerate(rows) if on), 0)
    steps = target - current
    return ["Down" if steps > 0 else "Up"] * abs(steps) + ["Enter"]


def setup_nag(screen):
    """(keys, what) for a startup dialog the router answers itself, else None."""
    for title, labels, pick in STARTUP:
        if title in screen:
            keys = menu_keys(screen, labels, pick)
            if keys:
                return keys, f"{title.rstrip('?:')} → {pick.split('|')[0]}"
    options = OPTION.findall(screen)
    labels = {label.lower().replace("’", "'") for _, label in options}
    wizard = "Also scan shell history" in screen and "Also scan your other repos" in screen
    if not (SETUP_NAG.search(screen) or {"not now", "don't show again"} <= labels or wizard):
        return None
    for n, label in options:
        if label.lower().replace("’", "'") == "don't show again":
            keys = option_keys(screen, int(n))
            return (keys, "dismissed auto-mode setup (Don't show again)") if keys else None
    if wizard and DIALOG.search(screen):
        return ["Escape"], "cancelled auto-mode setup"
    return None


def answer(name, choice):
    """choice: option number (as shown in the prompt) or 'n' to deny. Only acts while a prompt is open."""
    a = agents().get(name)
    screen = last_lines(a[0]) if a else ""
    if not a or not DIALOG.search(screen):
        return f"{name} has no open permission prompt"
    if choice == "n":
        tmux("send-keys", "-t", a[0], "Escape")
    else:
        keys = option_keys(screen, int(choice))
        if keys is None:
            return f"{name} has no option {choice}; answer in its pane or deny to cancel"
        tmux("send-keys", "-t", a[0], *keys)
    api("/messages", {"from": "room", "text": f"{ME} answered {name}'s prompt: "
                      + ("deny" if choice == "n" else f"option {choice}")})
    return "ok"


def alert(asking):
    """Make waiting permission prompts hard to miss: tmux status bar + desktop notification."""
    if not asking:
        return tmux("set-option", "-u", "-t", "room", "status-right")
    text = "🔐 waiting for approval: " + ", ".join(asking) + "  (type y in the chat)"
    tmux("set-option", "-t", "room", "status-right", "#[bg=red,fg=white,bold] " + text + " ")
    tmux("set-option", "-t", "room", "status-right-length", "120")
    try:
        subprocess.run(["notify-send", "-u", "critical", "Agent room", text], env=ENV, timeout=5)
    except Exception:
        pass  # no desktop session; the chat + tmux bar still show it


def router_state(sid, state=None):
    if not isinstance(sid, str) or not re.fullmatch(r'\d{8}-\d{6}', sid):
        raise ValueError('invalid room session id')
    path = os.path.join(SESSIONS, sid, 'router.json')
    if state is None:
        try:
            with open(path) as f:
                return json.load(f)
        except FileNotFoundError:
            return {}
    temp = path + f'.{os.getpid()}.tmp'
    with open(temp, 'w') as f:
        json.dump(state, f)
    os.replace(temp, path)


def router():
    active = api('/session')['id']
    saved = router_state(active)
    seen = saved.get('seen', max([m["id"] for m in api("/messages")] or [0]))
    pending = saved.get('pending', [])
    respawned, warned, asking = {}, False, {}  # asking: agent -> (pane, prompt), oldest first
    all_models, published, published_at = model_lists(), None, 0
    discovered_at, sessions_at, all_sessions = 0, 0, []
    nagged = {}  # agent -> (startup dialog, attempts): stops a dialog that won't close from looping
    auto_manager = False  # "/auto on" in the chat lets claude answer the workers' permission prompts
    # catch-up: each agent also gets the conversation it missed since its last delivery (e.g. a later @all)
    history = [m for m in api("/messages") if m["from"] != "room" and not m.get("replay") and m["id"] <= seen][-CATCHUP:]
    cursor = saved.get('cursor', {name: seen for name in agents()})  # advanced only after paste + Enter succeed

    def checkpoint():
        router_state(active, {'seen': seen, 'pending': pending, 'cursor': cursor})

    print("router up, after message #%d" % seen)
    while True:
        try:
            current = api('/session')['id']
            if current != active:
                pending.clear(); asking.clear(); respawned.clear(); history.clear(); cursor.clear()
                active, published, sessions_at, auto_manager = current, None, 0, False
                checkpoint()
                alert(asking)
            live = agents()
            for name in CORE:  # keep the core team alive
                if name not in live and time.time() - respawned.get(name, 0) > 20:  # backoff for crash loops
                    respawned[name] = time.time()
                    print("starting", name)
                    spawn(name, name, window="room:team")
            if time.time() - discovered_at > 5:
                record_conversations(live)
                discovered_at = time.time()
            for name, (pane, kind, born, _) in live.items():  # surface permission prompts in the chat
                screen = last_lines(pane)
                nag = setup_nag(screen)
                if nag:
                    keys, action = nag
                    tries = nagged.get(name, (None, 0))
                    tries = ((pane, action), tries[1] + 1 if tries[0] == (pane, action) else 1)  # changing dialog text must not reset retries
                    nagged[name] = tries
                    if tries[1] > 3:  # the keys didn't close it: hand it to the user once, then stop retrying
                        if tries[1] == 4:
                            api("/messages", {"from": "room", "text": f"⚠️ {name} is stuck on a startup dialog ({action}). "
                                 f"See it with /peek {name}, answer with /key {name} Down|Up|Enter"})
                        continue
                    tmux("send-keys", "-t", pane, *keys)
                    api("/messages", {"from": "room", "text": f"✅ {name}: auto-answered startup dialog: {action}"})
                    time.sleep(1)  # let the dialog close before the next scan
                    if name in asking:
                        del asking[name]
                        alert(asking)
                    continue
                nagged.pop(name, None)
                if time.time() - born > WARMUP and DIALOG.search(screen):
                    body = "\n".join(l for l in screen.splitlines() if not re.fullmatch(r"[\s─╌━-]+", l))
                    prompt = (pane, re.sub(r"(?m)^[ \t]*[❯›>]?[ \t]*(?=\d+\.)", "", body))
                    if asking.get(name) != prompt:
                        if name in asking:
                            api("/messages", {"from": "room", "text": f"✅ {name}: previous dialog replaced; see updated request below"})
                        asking[name] = prompt
                        opts = OPTION.findall(screen)
                        menu = "\n".join(f"   {n} = {t}" for n, t in opts) or "   1 = yes"
                        api("/messages", {"from": "room", "text": f"🔐 {name} needs your approval:\n{body}\n\n"
                             f"→ type a number to choose:\n{menu}\n   n = deny\n"
                             f"  (y = 1.  With several waiting, add the name: 2 {name})"})
                        alert(asking)
                        if name != "claude" and auto_manager and "claude" in live:
                            pending.append(("claude", None, f"[room] permission request from {name}:\n{body}\n"
                                f"You're the manager: if it's safe and within the task, approve it with "
                                f"`room approve {name} N` (N = option number; prefer the 'always allow' option "
                                f"for harmless repeated commands). Deny with `room deny {name}` and tell @user if "
                                f"it's destructive, touches secrets, or is outside the task. If unsure, leave it "
                                f"for @user."))
                elif name in asking:
                    del asking[name]
                    api("/messages", {"from": "room", "text": f"✅ {name}: permission answered, back to work"})
                    alert(asking)
            for name in [n for n in asking if n not in live]:
                del asking[name]
                alert(asking)
            if time.time() - sessions_at > 10:
                all_sessions = api('/sessions')['sessions']
                sessions_at = time.time()
            st = {"agents": [{"name": n, "kind": k, "asking": n in asking,
                              "model": tmux("show-options", "-p", "-v", "-t", p, "@model")}
                             for n, (p, k, _, _) in sorted(live.items())],
                  "models": all_models, "efforts": EFFORTS, "commands": COMMANDS, "native": NATIVE, "sessions": all_sessions, "session": active}
            # agents/models/commands for the browser + terminal autocomplete; resent every 10s so a
            # restarted server is never left empty
            if st != published or time.time() - published_at > 10:
                api("/state", st)
                published, published_at = st, time.time()
            msgs = api(f"/messages?since={seen}")
            for m in msgs:
                seen = m["id"]
                if m.get('replay'):
                    continue  # restored history is for readers; never replay old commands into agents
                if m.get('reset'):
                    pending.clear(); asking.clear(); respawned.clear(); history.clear(); cursor.clear()
                    alert(asking)
                if m["from"] == "room":  # notices are for humans; never deliver them to agents
                    continue
                if m["from"] == "user":
                    warned = False
                    # y / n (optionally + agent name) answers a waiting permission prompt
                    cmd = m["text"].lower().split()
                    if cmd[:1] == ["/auto"] and len(cmd) == 2:
                        auto_manager = cmd[1] == "on"
                        api("/messages", {"from": "room", "text": "claude " + ("may now answer" if auto_manager
                             else "will no longer answer") + " the other agents' permission prompts"})
                        continue
                    if cmd and cmd[0][0] == "/" and cmd[0][1:] in CHAT_CMDS:
                        checkpoint()  # never replay a CLI command if the router dies while running it
                        out = io.StringIO()
                        with contextlib.redirect_stdout(out):
                            failed = False
                            try:
                                args = m["text"].split(None, 2)[1:] if cmd[0] == "/send" else m["text"].split()[1:]
                                main([cmd[0][1:]] + args)
                            except (SystemExit, RuntimeError) as e:
                                failed = True
                                print(e)
                        api("/messages", {"from": "room", "text": f"{m['text']}\n{out.getvalue().strip()}"})
                        if not failed and cmd[0] in ('/new', '/resume', '/clear', '/fresh'):
                            pending.clear(); asking.clear(); respawned.clear(); history.clear(); cursor.clear()
                            published, sessions_at = None, 0
                            alert(asking)
                            break  # discard the old polling batch after changing or clearing its session
                        continue
                    if cmd and (cmd[0] in ("y", "yes", "n", "no") or cmd[0].isdigit()) and len(cmd) <= 2 and asking:
                        who = cmd[1] if len(cmd) == 2 else next(iter(asking))
                        if who in asking:
                            choice = "n" if cmd[0][0] == "n" else ("1" if cmd[0][0] == "y" else cmd[0])
                            result = answer(who, choice)
                            print(result)
                            if result != "ok":
                                api("/messages", {"from": "room", "text": result})
                            continue
                history.append(m)
                del history[:-CATCHUP - 1]  # +1: the message being delivered is in history too
                tags = set(re.findall(r"@([\w-]+)", m["text"].lower()))
                names = [a for a in live if tags & {"all", "everyone"} or a in tags]
                if not names:  # un-addressed messages go to the manager
                    names = ["claude"]
                if m["from"] != "user" and names:
                    hist = api(f"/messages?since={max(0, seen - MAX_AGENT_HOPS)}")
                    if len(hist) >= MAX_AGENT_HOPS and all(h["from"] != "user" for h in hist):
                        if not warned:
                            warned = True
                            api("/messages", {"from": "room", "text": f"Paused agent-to-agent delivery after "
                                 f"{MAX_AGENT_HOPS} messages without @user. Post anything to resume."})
                        continue
                for a in names:
                    if a == m["from"]:
                        continue
                    queued = max([cursor.get(a, 0)] + [mid for name, mid, _ in pending if name == a and mid is not None])
                    missed = [h for h in history if queued < h["id"] < m["id"] and h["from"] != a]
                    catchup = "".join(f"#{h['id']} {h['from']}: {h['text'][:CATCHUP_CHARS]}"
                                      + (f"…[cut; room log {CATCHUP + 1}]" if len(h['text']) > CATCHUP_CHARS else "")
                                      + "\n" for h in missed)
                    if catchup:
                        catchup = f"[room catch-up: {len(missed)} message(s) you missed]\n{catchup}[end catch-up]\n"
                    pending.append((a, m['id'], f"{catchup}[room #{m['id']}] {m['from']}: {m['text']}\n(answer with: room say ...)"))
            if msgs:
                checkpoint()
            live = agents()
            for item in list(pending):
                name, mid, text = item
                if name not in live:
                    if name not in CORE:
                        pending.remove(item)  # helper is gone; drop its mail
                        checkpoint()
                    continue
                pane, kind, born, _ = live[name]
                screen = last_lines(pane)
                if time.time() - born < WARMUP or DIALOG.search(screen) or setup_nag(screen):
                    continue
                # bracketed paste keeps multi-line messages as one input, then Enter submits it
                subprocess.run(["tmux", "load-buffer", "-b", "room", "-"], input=text, text=True, check=True)
                tmux("paste-buffer", "-p", "-d", "-b", "room", "-t", pane, check=True)
                time.sleep(0.5)
                tmux("send-keys", "-t", pane, "Enter", check=True)
                if mid is not None:
                    cursor[name] = mid
                pending.remove(item)
                # shortcut: a crash after Enter but before this save can duplicate a delivery; add agent acknowledgments if needed.
                checkpoint()
                print("delivered to", name, text[:80].replace("\n", " "))
        except Exception as e:
            print("error:", e)
            time.sleep(3)
        time.sleep(1)


def fmt(m):
    t = time.strftime("%H:%M:%S", time.localtime(m["ts"]))
    return f"\033[2m#{m['id']} {t}\033[0m \033[1;{COLORS.get(m['from'], 36)}m{m['from']}\033[0m: {m['text']}"


def chat():
    import readline
    signal.signal(signal.SIGHUP, signal.default_int_handler)  # closing the terminal acts like Ctrl-C
    prompt = f"\033[1;{COLORS.get(ME, 36)}m{ME}>\033[0m "

    def show(text):  # print above the input line without clobbering what's being typed
        sys.stdout.write("\r\033[K" + text + "\n" + prompt + readline.get_line_buffer())
        sys.stdout.flush()

    def watch(last):
        while True:
            try:
                for m in api(f"/messages?since={last}"):
                    last = m["id"]
                    if m["from"] == "room" and m["text"].startswith("🔐"):
                        show("\a\033[1;30;43m" + m["text"].replace("\n", "\033[K\n") + "\033[K\033[0m")
                    else:
                        show(fmt(m))
            except Exception as e:
                show(f"\033[31m(room unreachable: {e})\033[0m")
                time.sleep(3)
            time.sleep(1)

    if os.environ.get("ROOM_MAIN"):
        print("Ctrl-C here stops everything. Agents' own sessions: tmux attach -t room (another terminal).")
    print("Agent room. No @mention = goes to @claude (manager). Permission requests: type the option number, y (=1) or n.\n"
          "Commands: /who  /models  /model NAME MODEL [EFFORT]  /spawn NAME KIND [MODEL [EFFORT]]  /kill NAME\n"
          "          /auto on|off (let claude answer others' prompts; off by default)  /clear  /fresh  /log N\n"
          "          /send NAME TEXT...  /key NAME KEY...  /peek NAME [N]  /sessions  /resume ID  /new")
    def complete(text, i):  # Tab completion for @names, /commands and their arguments
        try:
            st = api("/state")
        except Exception:
            return None
        names = {a["name"]: a["kind"] for a in st.get("agents", [])}
        words = readline.get_line_buffer()[:readline.get_endidx()].split()
        if text and words and words[-1] == text:
            words = words[:-1]  # only the words before the one being completed
        if text.startswith("@"):
            opts = ["@" + n for n in [*names, "all"]]
        elif not words:
            opts = [c["cmd"] for c in st.get("commands", [])] + ["/log", "/quit"]
        else:
            cmd, n = words[0], len(words)
            kind = names.get(words[1]) if cmd == "/model" and n >= 2 else (words[2] if n >= 3 else None)
            opts = {
                ("/model", 1): list(names), ("/kill", 1): list(names), ("/approve", 1): list(names),
                ("/deny", 1): list(names), ("/auto", 1): ["on", "off"], ("/spawn", 2): ["claude", "codex", "agy"],
                ("/send", 1): list(names), ("/key", 1): list(names), ("/peek", 1): list(names),
                ("/resume", 1): [s['id'] for s in st.get('sessions', [])],
                ("/model", 2): st.get("models", {}).get(kind, []), ("/model", 3): st.get("efforts", {}).get(kind, []),
                ("/spawn", 3): st.get("models", {}).get(kind, []), ("/spawn", 4): st.get("efforts", {}).get(kind, []),
                ("/send", 2): st.get("native", {}).get(names.get(words[1]), []) if n >= 2 else [],
            }.get((cmd, n), KEYS if cmd == "/key" and n >= 2 else [])
        matches = [o + " " for o in opts if o.startswith(text)]
        return matches[i] if i < len(matches) else None

    readline.set_completer_delims(" \t\n")
    readline.set_completer(complete)
    readline.parse_and_bind("tab: complete")
    history = api("/messages")
    threading.Thread(target=watch, args=(history[-20]["id"] - 1 if len(history) > 20 else 0,), daemon=True).start()
    while True:
        try:
            line = input(prompt).strip()
        except (EOFError, KeyboardInterrupt):
            break
        if line == "/quit":
            break
        if line.startswith("/log"):
            main(line[1:].split())
        elif line:  # "/" commands go through the room too: the router runs them, everyone sees the result
            api("/messages", {"from": ME, "text": line})
    if os.environ.get("ROOM_MAIN"):
        down()


def main(argv):
    cmd, args = (argv[0], argv[1:]) if argv else ("attach", [])
    if cmd == "attach":
        up()
        os.execvpe("tmux", ["tmux", "attach", "-t", "room"], ENV)
    elif cmd == "up":
        up()
    elif cmd == "down":
        down()
    elif cmd == "chat":
        chat()
    elif cmd == "say":
        text = " ".join(args) if args else sys.stdin.read()
        print("posted #%d" % api("/messages", {"from": ME, "text": text.strip()})["id"])
    elif cmd == "log":
        for m in api("/messages")[-int(args[0] if args else 30):]:
            print(fmt(m))
    elif cmd == "who":
        for name, (pane, kind, born, win) in sorted(agents().items()):
            model = tmux("show-options", "-p", "-v", "-t", pane, "@model")
            print(f"{name:10} {kind:7} {model:28} window={win:8} up {int(time.time() - born) // 60}m")
    elif cmd in ("send", "key", "peek") and (len(args) in (1, 2) if cmd == "peek" else len(args) >= 2):
        a = agents().get(args[0])
        if not a:
            sys.exit(f"no agent named {args[0]}")
        if cmd == "send":
            text = " ".join(args[1:])
            if not text.strip():
                sys.exit("usage: room send NAME TEXT...")
            screen = last_lines(a[0])
            if DIALOG.search(screen) or setup_nag(screen):
                sys.exit(f"{args[0]} has an open dialog; answer it first")
            subprocess.run(["tmux", "load-buffer", "-b", "room", "-"], input=text, text=True)
            tmux("paste-buffer", "-p", "-d", "-b", "room", "-t", a[0])
            time.sleep(0.5)
            tmux("send-keys", "-t", a[0], "Enter")
            print(f"sent to {args[0]}")
            if text.startswith("/"):  # a CLI command: show what it printed
                time.sleep(3)
                print(last_lines(a[0], 25))
        elif cmd == "key":
            if any(key not in KEYS for key in args[1:]):
                sys.exit("allowed keys: " + " ".join(KEYS))
            tmux("send-keys", "-t", a[0], *args[1:])
            print(f"sent keys to {args[0]}")
        else:
            if len(args) == 2 and (not re.fullmatch(r"[0-9]+", args[1]) or int(args[1]) < 1):
                sys.exit("usage: room peek NAME [N] (N must be positive, max 120)")
            n = min(int(args[1]) if len(args) == 2 else 30, 120)
            print(last_lines(a[0], n))
    elif cmd == "spawn" and 2 <= len(args) <= 4:
        record = room_agents().get(args[0])
        if len(args) > 2:
            model, effort = set_model(args[0], args[1], *args[2:])
            if record:
                record = {**record, 'model': model, 'effort': effort}
        spawn(*args[:2], record=record)
    elif cmd == "model" and not args:  # bare /model: show what everyone runs and what's available
        main(["who"])
        print("\nswitch with: /model NAME MODEL [EFFORT]   (or use the dropdowns in the browser header)\n")
        models()
    elif cmd == "model" and 2 <= len(args) <= 3:
        a = agents().get(args[0])
        if not a:
            sys.exit(f"no agent named {args[0]}")
        model, effort = set_model(args[0], a[1], *args[1:])
        record_conversations(agents())
        record = room_agents().get(args[0])
        if record:
            record = {**record, 'model': model, 'effort': effort}
        kill(args[0], forget=False)
        spawn(args[0], a[1], window="room:team" if args[0] in CORE else None, record=record)
    elif cmd == "models":
        models()
    elif cmd == 'sessions' and not args:
        for s in api('/sessions')['sessions']:
            print(f"{'*' if s['current'] else ' '} {s['id']}  {s['started']}  agents: {', '.join(s['agents']) or '-'}  messages: {s['messages']}  {s['title']}")
    elif cmd == 'resume' and len(args) == 1 and args[0]:
        switch_room(args[0])
    elif cmd == 'new' and not args:
        switch_room()
    elif cmd == 'fresh' and not args:
        switch_room(fresh=True)
    elif cmd == "clear" and not args:
        api("/clear", {"from": "room", "text": "--- chat history cleared ---"})
        print("chat cleared (old history archived in the current session)")
    elif cmd == "approve" and len(args) in (1, 2) and (len(args) == 1 or args[1].isdigit()):
        print(answer(args[0], args[1] if len(args) == 2 else "1"))
    elif cmd == "deny" and len(args) == 1:
        print(answer(args[0], "n"))
    elif cmd == "kill" and len(args) == 1:
        kill(args[0])
    elif cmd == "router":
        router()
    elif cmd == "intro" and len(args) == 2:
        print(INTRO.format(name=args[0], kind=args[1], ws=WS, role=ROLES.get(args[0], WORKER)))
    else:
        usage = [l.strip() for l in __doc__.splitlines() if l.strip().startswith(f"room {cmd} ")]
        sys.exit("usage: " + usage[0] if usage and argv is not sys.argv[1:] else __doc__)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except RuntimeError as e:
        sys.exit(str(e))
