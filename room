#!/usr/bin/env python3
"""Agent room: a shared chat where claude (manager), codex, agy and any spawned helpers work as a team.
  room                    start everything that isn't running and attach to the tmux session
  room up                 start everything that isn't running (server, tmux session 'room', router)
  room down               stop everything (also: Ctrl-C in the main chat pane)
  room chat               chat as $ROOM_NAME (default 'user'); /commands work inside (and in the browser)
  room say [TEXT]         post a message (TEXT, or stdin if omitted)
  room log [N]            print the last N messages (default 30)
  room who                list running agents
  room spawn NAME KIND [MODEL [EFFORT]]  start a new agent (KIND: claude|codex|agy) in its own tmux window
  room model NAME MODEL [EFFORT]          restart an agent on another model (it catches up from the chat)
  room models             list the models each CLI offers
  room approve NAME [N]   answer an agent's permission prompt with option N (default 1 = yes)
  room deny NAME          reject an agent's permission prompt
  room send NAME TEXT...  type text or a CLI slash command into an agent and press Enter
  room key NAME KEY...    send allowed keys to an agent's picker/menu
  room peek NAME [N]     show the last N non-empty pane lines (default 30, max 120)
  room kill NAME          stop an agent (core agents claude/codex/agy get restarted by the router)
  room sessions           list saved room sessions (current session marked *)
  room resume ID          restore a room session and each agent's own CLI conversation
  room new                start a new room session with fresh core agents and empty chat
  room clear              archive and clear the current room session's chat
  room fresh              clear chat and start fresh CLI conversations in the same room session
  room router             deliver messages into agent panes, keep core agents alive (started by `up`)
  room intro NAME KIND    print an agent's onboarding prompt (used at spawn)"""
import contextlib, datetime, fcntl, glob, io, json, os, re, shlex, signal, sqlite3, subprocess, sys, threading, time, urllib.request, uuid

