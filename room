def api(path, data=None):
    req = urllib.request.Request(ROOM + path, json.dumps(data).encode() if data is not None else None,
                                 {"Content-Type": "application/json"})
    return json.load(urllib.request.urlopen(req, timeout=10))


def tmux(*args, check=False):
    return subprocess.run(["tmux", *args], capture_output=True, text=True, env=ENV, check=check).stdout.strip()


def agents():
    """name -> (pane_id, kind, born, window)"""
    out = tmux("list-panes", "-a", "-F", "#{session_name} #{pane_id} #{window_name} #{@agent} #{@kind} #{@born}")
    r = {}
    for line in out.splitlines():
        s, pane, win, *rest = line.split()
        if s == "room" and len(rest) == 3:
            r[rest[0]] = (pane, rest[1], float(rest[2]), win)
    return r


def room_agents(sid=None):
    sid = sid or api('/session')['id']
    if not sid:
        return {}
    if not re.fullmatch(r'\d{8}-\d{6}', sid):
        sys.exit('invalid room session id')
    try:
        with open(os.path.join(SESSIONS, sid, 'agents.json')) as f:
            return {a['name']: a for a in json.load(f)}
    except FileNotFoundError:
        return {}


def save_agent(record=None, remove=None):
    sid = api('/session')['id']
    if not sid:
        return
    path = os.path.join(SESSIONS, sid)
    with open(os.path.join(path, '.agents.lock'), 'a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        roster = room_agents(sid)
        if record:
            roster[record['name']] = record
        if remove:
            roster.pop(remove, None)
        temp = os.path.join(path, f'.agents-{os.getpid()}.tmp')
        with open(temp, 'w') as f:
            json.dump(list(roster.values()), f, indent=2)
        os.replace(temp, os.path.join(path, 'agents.json'))


def discover(record):
    marker = 'Room launch: ' + record.get('launch_id', '')
    if not record.get('launch_id'):
        return None
    born = record['born']
    if record['kind'] == 'codex':
        paths = glob.glob(f'{HOME}/.codex/sessions/*/*/*/rollout-*.jsonl')
        for path in sorted(paths, key=os.path.getmtime, reverse=True):
            if os.path.getmtime(path) < born - 5:
                continue
            try:
                with open(path) as f:
                    meta = json.loads(next(f))['payload']
                    if meta.get('cwd') != WS or meta.get('source') != 'cli':
                        continue
                    if datetime.datetime.fromisoformat(meta['timestamp'].replace('Z', '+00:00')).timestamp() < born - 5:
                        continue
                    for _, line in zip(range(64), f):
                        payload = json.loads(line).get('payload', {})
                        if payload.get('role') == 'user' and any(marker in c.get('text', '') for c in payload.get('content', [])):
                            return str(uuid.UUID(meta['id']))
            except (OSError, ValueError, KeyError, StopIteration):
                continue
    elif record['kind'] == 'agy':
        paths = glob.glob(f'{HOME}/.gemini/antigravity-cli/conversations/*.db')
        for path in sorted(paths, key=os.path.getmtime, reverse=True):
            if os.path.getmtime(path) < born - 5:
                continue
            try:
                with contextlib.closing(sqlite3.connect('file:' + path + '?mode=ro', uri=True, timeout=0.1)) as db:
                    step = db.execute('SELECT step_payload FROM steps ORDER BY idx LIMIT 1').fetchone()
                    workspace = db.execute('SELECT data FROM trajectory_metadata_blob LIMIT 1').fetchone()
                    # shortcut: match the embedded intro/URI in agy's protobuf blobs; use its API if the schema changes.
                    if step and workspace and marker.encode() in step[0] and ('file://' + WS).encode() in workspace[0]:
                        return str(uuid.UUID(os.path.basename(path)[:-3]))
            except (OSError, sqlite3.Error, ValueError, TypeError):
                continue
    return None


def record_conversations(live):
    try:
        roster = room_agents()
    except (OSError, ValueError) as e:
        print(f'could not read conversation records: {e}')
        return
    for name, record in roster.items():
        if name not in live or record.get('conversation_id') or time.time() - record.get('born', 0) > 300:
            continue
        try:
            conversation = discover(record)
            if conversation:
                save_agent({**record, 'conversation_id': conversation})
        except (OSError, ValueError) as e:
            print(f'could not record {name} conversation: {e}')


def claude_session_exists(conversation):
    """claude pins --session-id before the transcript exists; a respawn must not --resume one that was never written (crash during setup)."""
    proj = re.sub(r'[^a-zA-Z0-9]', '-', WS)
    return os.path.exists(os.path.join(HOME, '.claude', 'projects', proj, conversation + '.jsonl'))


def load_preferences():
    try:
        with open(os.path.join(DIR, 'data', 'preferences.json')) as f:
            return json.load(f)
    except FileNotFoundError:
        return {}


def agent_settings(name, kind, record=None):
    preferences = load_preferences()
    for key in (name, kind):
        saved = preferences.get(key)
        if saved and saved['kind'] == kind:
            return saved['model'], saved['effort']
    cfg = tmux("show-options", "-v", "-t", "room", f"@cfg-{name}")
    if cfg:
        return tuple((cfg.split() + [""])[:2])
    if record and record['kind'] == kind:
        return record['model'], record['effort']
    return DEFAULTS[kind]


def ensure_trust(kind):
    """Pre-trust the workspace so a CLI doesn't prompt on launch (auto-answer stays as the fallback).
    claude uses IS_SANDBOX=1 in its pane env instead of a config entry."""
    try:
        if kind == "codex":
            path = os.path.join(HOME, ".codex", "config.toml")
            block = f'[projects."{WS}"]'
            text = open(path).read() if os.path.exists(path) else ""
            if block not in text:
                with open(path, "a") as f:
                    f.write(f'\n{block}\ntrust_level = "trusted"\n')
        elif kind == "agy":
            path = os.path.join(HOME, ".gemini", "antigravity-cli", "settings.json")
            if os.path.exists(path):
                d = json.load(open(path))
                tw = d.setdefault("trustedWorkspaces", [])
                if isinstance(tw, list) and WS not in tw:
                    tw.append(WS)
                    temp = path + f".{os.getpid()}.tmp"
                    json.dump(d, open(temp, "w"), indent=2)
                    os.replace(temp, path)
    except (OSError, ValueError) as e:
        print(f"ensure_trust({kind}): {e}")


def spawn(name, kind, window=None, record=None):
    if not re.fullmatch(r"[a-z][a-z0-9_-]{0,15}", name) or kind not in DEFAULTS or name in ("user", "all", "room"):
        sys.exit("usage: room spawn NAME claude|codex|agy [MODEL [EFFORT]]   (NAME lowercase, not user/all/room)")
    if name in agents():
        return print(f"{name} is already running")
    record = record or room_agents().get(name)
    if record and record['kind'] != kind:
        record = None
    model, effort = agent_settings(name, kind, record)
    conversation = record.get('conversation_id', '') if record else ''
    resume = bool(conversation)
    if resume and kind == 'claude' and not claude_session_exists(conversation):
        resume = False  # session-id was pinned but never persisted; start fresh, reusing the id
    if kind == 'claude' and not conversation:
        conversation = str(uuid.uuid4())
    born, launch_id = time.time(), str(uuid.uuid4())
    if resume:
        prompt = f'You are @{name}, resumed into the agent room. Continue using room say to talk to the team. Run room log 40 for the current room context, then wait for new room messages.'
    else:
        prompt = INTRO.format(name=name, kind=kind, ws=WS, role=ROLES.get(name, WORKER)) + f'\nRoom launch: {launch_id}'
    ensure_trust(kind)
    cmd = cli(kind, model, effort, conversation, resume) + ' ' + shlex.quote(prompt)
    opts = ["-c", WS, "-e", f"ROOM_NAME={name}"] + (["-e", "IS_SANDBOX=1"] if kind == "claude" else []) + ["-P", "-F", "#{pane_id}"]
    if window:
        pane = tmux("split-window", "-t", window, *opts, cmd)
        tmux("select-layout", "-t", window, "tiled")
    else:
        pane = tmux("new-window", "-d", "-t", "room:", "-n", name, *opts, cmd)
    if not pane:
        raise RuntimeError(f'could not start {name}')
    for k, v in (("@agent", name), ("@kind", kind), ("@born", str(born)), ("@model", f"{model} {effort}")):
        tmux("set-option", "-p", "-t", pane, k, v)
    save_agent({'name': name, 'kind': kind, 'model': model, 'effort': effort,
                'conversation_id': conversation, 'born': born, 'launch_id': launch_id})
    print(f"spawned {name} ({kind}, {model} {effort})" + (' [resumed]' if resume else ' [fresh]'))


def set_model(name, kind, model, effort=None):
    if not re.fullmatch(r"[a-z][a-z0-9_-]{0,15}", name) or kind not in DEFAULTS or name in ("user", "all", "room"):
        sys.exit("invalid agent name or kind")
    path = os.path.join(DIR, 'data', 'preferences.json')
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(os.path.join(DIR, 'data', '.preferences.lock'), 'a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if effort is None:
            effort = agent_settings(name, kind, room_agents().get(name))[1]
        if not all(re.fullmatch(r"[\w.:-]+", x) for x in (model, effort or "x")):
            sys.exit("bad model or effort name")
        preferences = load_preferences()
        preferences[name] = {'kind': kind, 'model': model, 'effort': effort}
        temp = path + f'.{os.getpid()}.tmp'
        with open(temp, 'w') as f:
            json.dump(preferences, f, indent=2)
        os.replace(temp, path)
    tmux("set-option", "-t", "room", f"@cfg-{name}", f"{model} {effort}".strip())
    # shortcut: native CLI /effort changes bypass room bookkeeping; use /model NAME MODEL EFFORT for durable choices.
    return model, effort


